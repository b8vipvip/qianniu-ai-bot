<ew:EtWindow
    x:Class="Bot.Options.WndOption"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ew="clr-namespace:Bot.Common.Windows"
    ew:Closed="EtWindow_Closed"
    ew:Title="设置"
    Width="1080"
    Height="760"
    MinWidth="900"
    MinHeight="600"
    SizeToContent="Manual"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner">
    <FrameworkElement.Resources>
        <SolidColorBrush x:Key="SettingsPageBackground" Color="#F3F6FA" />
        <SolidColorBrush x:Key="SettingsCardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SettingsBorder" Color="#E2E8F0" />
        <SolidColorBrush x:Key="SettingsPrimary" Color="#2563EB" />
        <SolidColorBrush x:Key="SettingsText" Color="#1F2937" />
        <SolidColorBrush x:Key="SettingsMuted" Color="#667085" />

        <Style x:Key="SettingsNavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="8 2" />
            <Setter Property="Padding" Value="12 7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SettingsText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#BFDBFE"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="NavBorder" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#98A2B3" />
            <Setter Property="Margin" Value="18 16 12 5" />
        </Style>

        <Style x:Key="SettingsSecondaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14 5" />
            <Setter Property="Margin" Value="8 0 0 0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsSecondaryButton}">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Background" Value="{StaticResource SettingsPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </FrameworkElement.Resources>

    <Grid Background="{StaticResource SettingsPageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource SettingsBorder}" BorderThickness="0 0 0 1">
            <Grid Margin="22 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Bot 设置" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource SettingsText}" />
                    <TextBlock x:Name="txtShopScope" Text="正在识别当前店铺..." Margin="0 4 0 0"
                               Foreground="{StaticResource SettingsMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="16" Padding="12 6" VerticalAlignment="Center">
                    <TextBlock Text="按店铺独立保存" Foreground="#1D4ED8" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18 16 18 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource SettingsBorder}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="设置导航" Margin="18 16 18 8" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsText}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="navPanel" Margin="0 0 0 14" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource SettingsBorder}"
                    BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource SettingsBorder}" BorderThickness="0 0 0 1">
                        <Grid Margin="20 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtPageTitle" Text="设置" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource SettingsText}" />
                                <TextBlock x:Name="txtPageDescription" Margin="0 5 18 0" Foreground="{StaticResource SettingsMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="页面帮助" Style="{StaticResource SettingsSecondaryButton}"
                                    Click="btnHelp_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ContentControl Grid.Row="1" x:Name="contentHost" Margin="12"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    ClipToBounds="True" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource SettingsBorder}" BorderThickness="0 1 0 0">
            <Grid Margin="18 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="btnRestoreCurrent" Content="恢复当前页默认" HorizontalAlignment="Left"
                        Style="{StaticResource SettingsSecondaryButton}" Margin="0"
                        Click="btnRestoreCurrentPageToDef_Click"
                        ToolTip="仅恢复当前页面；知识、规则和通知等业务数据不会一键清空。" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="取消" IsCancel="True" Style="{StaticResource SettingsSecondaryButton}"
                            Click="btnCancel_Click" />
                    <Button x:Name="btnSave" Content="保存设置" IsDefault="True"
                            Style="{StaticResource SettingsPrimaryButton}" Click="sbSave_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ew:EtWindow>
