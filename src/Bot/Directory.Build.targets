<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Keep the repository-wide legacy targets that were previously discovered from src/. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Directory.Build.targets')" />

  <!-- Knowledge V2 operator extensions must also compile in WPF *_wpftmp projects. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\KnowledgeV2NaturalLanguageService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeV2NaturalLanguageService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeV2OperatorUiBridge.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeV2LegacyDeltaImportService.cs" />
  </ItemGroup>
</Project>
