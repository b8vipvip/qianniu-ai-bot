<Project>
  <!-- Preserve repository-wide reference paths and compile items for Bot and WPF *_wpftmp projects. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Directory.Build.props')" />

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\RulePolicyImportExportUi.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\RulePolicyImportExportUi.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\KnowledgeCloudSyncService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCloudSyncService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\ClientDataCloudBackupService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\ClientDataCloudBackupService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ShopScope\ShopContext.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\IShopScopedPathProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopContextLocator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopControlPlaneConnectionStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopIdentityResolver.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopKeyGenerator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopProfile.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopProfileStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopScopedBuyerRuntimeService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopScopedParamBridge.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopScopedPathProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopScopedSettingsStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopSettingsScope.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopTokenStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Options\ShopBindingOptionsControl.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\BusinessPolicyProfileService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\BusinessPolicyProfileService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\BusinessPolicyProfileUi.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\BusinessPolicyProfileUi.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\BulkListManagementUi.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\BulkListManagementUi.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\BulkListManagementUiBridge.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\BulkListManagementUiBridge.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\HandoffPolicyLegacyMigrationService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\HandoffPolicyLegacyMigrationService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Options\HandoffPolicyUi.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Options\HandoffPolicyUi.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)default-business-policy.json')">
    <Content Include="$(MSBuildThisFileDirectory)default-business-policy.json">
      <Link>default-business-policy.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
